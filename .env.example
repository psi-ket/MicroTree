# Research Studio runtime configuration.
# Copy to `.env` in the repository root (or point RS_ENV_FILE at another file).
# Variables already set in the shell take precedence over this file.
# Every setting is optional; the values below are the defaults.

# --- Network -----------------------------------------------------------------
# The runtime only binds to loopback: 127.0.0.1, localhost or ::1.
# (The web app itself connects to 127.0.0.1 / localhost only.)
RS_HOST=127.0.0.1
RS_PORT=4317

# Browser origins allowed to call the runtime (comma separated, exact match).
RS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Where the web app is served; used for the connect link printed at startup.
RS_WEB_URL=http://127.0.0.1:5173

# --- Storage -----------------------------------------------------------------
# Runtime data: SQLite database and runtime-secret.json (pairing token).
# Default: ~/.research-studio
# RS_DATA_DIR=
# Database file. Default: <RS_DATA_DIR>/studio.db
# RS_DB_PATH=
# Projects are created as plain folders inside this directory, and only
# folders inside it can be opened. Default: ~/ResearchStudio/Projects
# RS_WORKSPACE_ROOT=

# --- Authentication ----------------------------------------------------------
# Fixed pairing token (min. 32 characters) instead of the generated one stored
# in <RS_DATA_DIR>/runtime-secret.json. Meant for tests and automation only.
# RS_PAIRING_TOKEN=
# Sliding session lifetime in milliseconds (12 h).
RS_SESSION_TTL_MS=43200000

# --- LaTeX toolchain ---------------------------------------------------------
# Absolute paths, if latexmk / synctex are not on PATH.
# RS_LATEXMK_PATH=
# RS_SYNCTEX_PATH=
# Kill a compilation after this many milliseconds (3 min).
RS_COMPILE_TIMEOUT_MS=180000
# Compilations of different projects that may run at the same time.
RS_MAX_CONCURRENT_COMPILES=2

# --- Limits and logging ------------------------------------------------------
# Maximum upload size in bytes (25 MiB).
RS_MAX_UPLOAD_BYTES=26214400
# fatal | error | warn | info | debug | trace | silent
RS_LOG_LEVEL=info

# --- AI assistant -----------------------------------------------------------
# Where API keys entered in the app are kept:
#   auto    - OS credential store; in memory if none is available (default)
#   keyring - OS credential store only; refuse to start without one
#   file    - <RS_DATA_DIR>/secrets.json with owner-only permissions
#   memory  - never written to disk; forgotten when the runtime stops
RS_SECRET_STORE=auto
# Give up on a model answer after this many milliseconds (3 min).
RS_AI_TIMEOUT_MS=180000
# Upper limit on the length of one model answer, in tokens.
RS_AI_MAX_OUTPUT_TOKENS=8192
# Keys for the official endpoints, used when no key was entered in the app.
# They are never sent to a provider with a custom base URL, and command-line
# agents do NOT receive them unless agents.json allows it per agent
# ({"environment": {"claude-code": {"allow": ["ANTHROPIC_API_KEY"]}}}).
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# --- Command-line agents -----------------------------------------------------
# on | off. Off hides Claude Code, Codex and custom agents entirely.
RS_AGENTS=on
# Stop an agent run after this many milliseconds (15 min).
RS_AGENT_TIMEOUT_MS=900000
# Total size of the project copies agents work on at the same time (2 GiB).
# Copies are removed when their run ends; leftovers are swept at startup and
# hourly.
RS_AGENT_STAGING_MAX_BYTES=2147483648
# Absolute paths, if `claude` / `codex` are not on PATH.
# RS_CLAUDE_PATH=
# RS_CODEX_PATH=
# Windows only: Codex sandbox mode. "elevated" needs a one-time setup by
# Codex; "unelevated" works without it.
RS_CODEX_WINDOWS_SANDBOX=unelevated
# Custom agents and per-agent environment policy (see README).
# Default: <RS_DATA_DIR>/agents.json
# RS_AGENTS_FILE=

# --- Literature search -------------------------------------------------------
# on | off. Searches OpenAlex, Semantic Scholar, arXiv and Crossref. Only the
# runtime talks to these services; the browser never does.
RS_LITERATURE=on
# Contact address sent to OpenAlex and Crossref only (Crossref then serves
# requests from its faster "polite" pool). Unset by default: nothing is sent.
# RS_LITERATURE_MAILTO=
# Deadline for one search across all providers, in milliseconds.
RS_LITERATURE_TIMEOUT_MS=25000
# Optional free keys, used when no key was entered in the app. Keys entered in
# the app are kept in the secret store above.
# OPENALEX_API_KEY=
# SEMANTIC_SCHOLAR_API_KEY=

# --- Personal library --------------------------------------------------------
# Where library PDFs are stored (by content hash, outside SQLite).
# Default: <RS_DATA_DIR>/library
# RS_LIBRARY_DIR=
# Largest PDF accepted, in bytes (1 MB to 2 GB).
RS_LIBRARY_MAX_PDF_BYTES=104857600
# Zotero is optional; nothing contacts it until a key is stored in the app
# or the local API is turned on there. Base URLs (tests point them at mocks):
# RS_ZOTERO_URL=https://api.zotero.org
# RS_ZOTERO_LOCAL_URL=http://localhost:23119/api
# API base URLs, for mirrors and tests. Default: the public endpoints.
# RS_OPENALEX_URL=https://api.openalex.org
# RS_SEMANTIC_SCHOLAR_URL=https://api.semanticscholar.org/graph/v1
# RS_ARXIV_URL=https://export.arxiv.org/api/query
# RS_CROSSREF_URL=https://api.crossref.org

# --- Web app (read by Vite) --------------------------------------------------
# Port of the web dev / preview server.
# RS_WEB_PORT=5173

# --- Full text and search (M3.3) ---------------------------------------------
# GROBID extracts the structure of PDFs. It must run on this computer unless
# RS_GROBID_ALLOW_REMOTE=1 (then your PDFs are sent to that host). Start it with:
#   docker run --rm --init --ulimit core=0 -p 127.0.0.1:8070:8070 grobid/grobid:0.9.1-crf
RS_GROBID=on
# RS_GROBID_URL=http://127.0.0.1:8070
# RS_GROBID_ALLOW_REMOTE=0
# RS_GROBID_TIMEOUT_MS=180000
# GROBID consolidation calls external metadata services from the GROBID server.
# RS_GROBID_CONSOLIDATION=0
# PyMuPDF (pip install pymupdf) reads page geometry and is the fallback extractor.
RS_PYMUPDF=auto
# RS_PYTHON=python3
# RS_INGESTION_CONCURRENCY=2
# RS_INGESTION_MAX_PAGES=500
# Local embeddings for semantic search (turned on in the app). Base URLs on
# another computer are refused unless RS_EMBEDDINGS_ALLOW_REMOTE=1.
# RS_OLLAMA_URL=http://127.0.0.1:11434
# RS_EMBEDDINGS_ALLOW_REMOTE=0
