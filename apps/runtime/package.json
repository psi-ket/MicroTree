{
  "name": "@research-studio/runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "research-studio-runtime": "./dist/main.js"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "start": "node dist/main.js",
    "start:dev": "tsx src/main.ts",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "token:rotate": "tsx src/cli/rotate-token.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@fastify/multipart": "^10.1.6",
    "@fastify/websocket": "^11.3.6",
    "@google/genai": "2.32.0",
    "@napi-rs/keyring": "2.1.2",
    "@research-studio/agent-adapters": "workspace:*",
    "@research-studio/ai-core": "workspace:*",
    "@research-studio/ai-storage": "workspace:*",
    "@research-studio/api-contracts": "workspace:*",
    "@research-studio/citation-intelligence": "workspace:*",
    "@research-studio/claim-anchors": "workspace:*",
    "@research-studio/database": "workspace:*",
    "@research-studio/document-engine": "workspace:*",
    "@research-studio/document-intelligence": "workspace:*",
    "@research-studio/evidence-engine": "workspace:*",
    "@research-studio/latex-engine": "workspace:*",
    "@research-studio/literature-engine": "workspace:*",
    "@research-studio/model-adapters": "workspace:*",
    "@research-studio/paper-ingestion": "workspace:*",
    "@research-studio/research-library": "workspace:*",
    "@research-studio/research-retrieval": "workspace:*",
    "@research-studio/shared-types": "workspace:*",
    "@research-studio/visual-artifacts": "workspace:*",
    "@research-studio/visual-assets": "workspace:*",
    "@research-studio/visual-engine": "workspace:*",
    "@research-studio/writing-intelligence": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "openai": "7.47.0",
    "pdfjs-dist": "6.5.438",
    "pino-pretty": "^13.2.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/ws": "^8.18.2",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "ws": "^8.22.1"
  }
}
